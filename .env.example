# Copy this file to .env. .env is gitignored.
BASE_URL=https://u.co.uk

# Existing account for the login test and the signed-in watch test.
U_EMAIL=
U_PASSWORD=

# Inbox you control. The register test adds +timestamp before the @ so each run is a new account.
# example: you@example.com becomes you+1710000000000@example.com
U_REGISTER_EMAIL=
